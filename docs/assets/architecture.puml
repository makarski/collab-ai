@startuml architecture
' Render from the repository root:
' plantuml -tsvg -nometadata docs/assets/architecture.puml

title collab-ai · How it fits together

!$humanColor = "#fff3b0"
!$brokerColor = "#lightblue"
!$agentColor = "#palegreen"

<style>
title {
    FontSize 25
}
document {
    Margin 24
    BackgroundColor #fafafa
}
rectangle {
    LineStyle 5
    LineColor #grey
    LineThickness 2
}
.HumanControl {
    BackgroundColor $humanColor
}
.Broker {
    BackgroundColor $brokerColor
}
.AgentRuntime {
    BackgroundColor $agentColor
}
.startupFlow {
    LineColor #indigo
    LineThickness 1
}
.controlFlow {
    LineColor #indigo
    LineThickness 2
}
.peerFlow {
    LineColor #deepPink
    LineThickness 2
}
.sessionFlow {
    LineColor #teal
    LineThickness 2
}
legend {
    FontSize 14
    Padding 15
    BackgroundColor #f0f0f0
}
</style>

hide stereotype
skinparam {
    backgroundColor #fafafa
    shadowing false
    componentStyle rectangle
    defaultFontSize 16
    padding 10
    nodesep 40
    ranksep 25
}

rectangle "One machine" as Local {
    rectangle "Managed Codex · automatic listening" as CodexPath {
        actor "Human operator" as Human
        component "=collab-codex --terminal\n//Launch command//" as Launcher <<HumanControl>>
        component "=Codex terminal UI\n//Normal Codex interface//" as UI <<AgentRuntime>>
        component "=Proxy and listener\n//Inside collab-codex//" as Proxy <<Broker>>
        component "=Codex App Server\n//One managed thread//" as AppServer <<AgentRuntime>>
        component "=MCP stdio relay\n//collab_runtime tools//" as Relay
    }

    rectangle "Claude channel · automatic listening" as ClaudePath {
        component "=Claude Code\n//Channel opt-in and org policy required//" as Claude <<AgentRuntime>>
        component "=collab-mcp\n~--claude-channel ~--auto-listen" as ClaudeMCP
    }

    rectangle "Alternative · manual inbox checks" as ManualPath {
        component "=Codex or Claude Code" as ManualAgent <<AgentRuntime>>
        component "=collab-mcp\n//Default mode//" as ManualMCP
    }

    component "=collab-ai broker\n//One owner per logical inbox//" as Broker <<Broker>>
    component "=Operator console\ncollab status / dashboard" as Console <<HumanControl>>
    database "=SQLite\nMessages, sessions and receipts" as Store
}

' Startup / process ownership.
Human .right.> Launcher <<startupFlow>> : launches
Launcher .down.> UI <<startupFlow>> : starts
Launcher .down.> Proxy <<startupFlow>> : runs
Proxy .down.> AppServer <<startupFlow>> : starts
AppServer .down.> Relay <<startupFlow>> : starts

' Native sessions and the managed Codex relay loop.
Human <--> UI <<controlFlow>> : prompts, output\nand approvals
UI <-down-> Proxy <<sessionFlow>> : WebSocket / private Unix socket
Proxy <-down-> AppServer <<sessionFlow>> : App Server / stdio\nTools and incoming peer context
AppServer <-down-> Relay <<sessionFlow>> : MCP / stdio
Relay <--> Proxy <<sessionFlow>> : MCP / private Unix socket\nSame listener and inbox owner

Claude <-down-> ClaudeMCP <<sessionFlow>> : MCP / stdio\nTools and channel notifications
ManualAgent <-down-> ManualMCP <<sessionFlow>> : MCP / stdio\nsend, receive, wait_reply, acknowledge

Proxy <--> Broker <<peerFlow>> : Broker protocol / Unix socket
ClaudeMCP <--> Broker <<peerFlow>> : Broker protocol / Unix socket
ManualMCP <--> Broker <<peerFlow>> : Broker protocol / Unix socket
Console <--> Broker <<controlFlow>> : Read-only status / Unix socket
Broker <--> Store : Persist state and replay\nunacknowledged messages

legend bottom
    <color:indigo>┄┄</color> Startup    <color:indigo>━━</color> Human / operator control
    <color:teal>━━</color> Native session integration    <color:deepPink>━━</color> Broker messages
    ----
    Solid arrows show communication. Each agent has a separate durable inbox.
endlegend

@enduml
