@startuml sandbox-macos
' Render from the repository root:
' plantuml -tsvg -nometadata docs/assets/sandbox-macos.puml

title Sandbox on macOS

<style>
title {
    FontSize 25
}
document {
    Margin 20
    BackgroundColor #fafafa
}
rectangle {
    LineStyle 5
    LineColor #grey
    LineThickness 2
}
.Workspace {
    BackgroundColor #e7f5eb
}
.Secured {
    BackgroundColor #e3efff
}
</style>

hide stereotype
skinparam {
    backgroundColor #fafafa
    shadowing false
    componentStyle rectangle
    defaultFontSize 18
    padding 12
}

rectangle "Your Mac\nYou administer Incus and open workspace SSH here" as Mac {
    rectangle "Colima VM: collab-ai\nLinux + Incus server" as VM {
rectangle "Incus project: collab-ai" as Project {
    component Secured <<Secured>> [
        =secured · control (optional)
        One broker + SQLite database
        --
        Private persistent state
        No network interface
    ]
    component Workspace <<Workspace>> [
        =workspace · dev
        Your repository, builds and tests
        Commands run as unprivileged agent
        --
        Codex + Claude adapters
        Read-only dashboard
        Rootless Docker + Compose
        Selected host mounts optional
        Network access enabled by default
    ]
    folder "Persistent dev volumes\n/workspace · /home/agent\n/var/lib/collab-ai-docker\nRetained when dev is replaced" as Data <<Workspace>>
    Workspace -down-> Data
}
    }
Secured -down-> Workspace : Shared broker socket (UDS)\nRead-only mount in workspace
}

caption Dev: managed bridge, opt out with dev_network_enabled = false. Control: offline.

@enduml
