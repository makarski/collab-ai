@startuml sandbox-macos
' Render from the repository root:
' plantuml -tsvg -nometadata docs/assets/sandbox-macos.puml

title Sandbox on macOS

<style>
title {
    FontSize 25
}
document {
    Margin 20
    BackgroundColor #fafafa
}
rectangle {
    LineStyle 5
    LineColor #grey
    LineThickness 2
}
.Workspace {
    BackgroundColor #e7f5eb
}
.Secured {
    BackgroundColor #e3efff
}
</style>

hide stereotype
skinparam {
    backgroundColor #fafafa
    shadowing false
    componentStyle rectangle
    defaultFontSize 18
    padding 12
}

rectangle "Your Mac\nYou administer Incus and open workspace SSH here" as Mac {
    rectangle "Colima VM: collab-ai\nLinux + Incus server" as VM {
rectangle "Incus project: collab-ai" as Project {
    component Secured <<Secured>> [
        =secured · optional
        Codex supervisor + broker
        Private budgets and configuration
        --
        Agents cannot edit caps
    ]
    component Workspace <<Workspace>> [
        =workspace · dev
        Your repository, builds and tests
        Commands run as unprivileged agent
        --
        collab-ai · Codex · Claude installed
        Selected host mounts optional
    ]
}
    }
Secured -down-> Workspace : Commands via Unix socket (UDS)\nResults return to supervisor
}

caption Both containers are offline. Protected login and interactive sessions are not connected yet.

@enduml
