@startuml sandbox-linux
' Render from the repository root:
' plantuml -tsvg -nometadata docs/assets/sandbox-linux.puml

title Sandbox on Linux

<style>
title {
    FontSize 25
}
document {
    Margin 20
    BackgroundColor #fafafa
}
rectangle {
    LineStyle 5
    LineColor #grey
    LineThickness 2
}
.Workspace {
    BackgroundColor #e7f5eb
}
</style>

hide stereotype
skinparam {
    backgroundColor #fafafa
    shadowing false
    componentStyle rectangle
    defaultFontSize 18
    padding 12
}

rectangle "Your Linux machine\nRuns the Incus server directly" as Host {
rectangle "Incus project: collab-ai" as Project {
    component Workspace <<Workspace>> [
        =workspace
        Offline Linux container
        collab-ai · Codex · Claude Code
        SSH terminal via Incus
        --
        Defaults: 2 CPUs · 4 GiB RAM · 10 GiB disk
        No network or host mounts
        No credentials
    ]
}
}

@enduml
