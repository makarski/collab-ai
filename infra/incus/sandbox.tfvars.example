# Copy to sandbox.auto.tfvars and set your Incus socket.
# macOS bootstrap prints the socket; Linux commonly uses /var/lib/incus/unix.socket.
incus_socket = "/absolute/path/to/.colima/collab-ai/incus.sock"
# Copy the builder's image.tfvars.json to image.auto.tfvars.json alongside this file.
# It supplies image_file and image_fingerprint; do not duplicate them here.

project_name = "collab-ai"
storage_pool = "default"
cpu_count    = 2
memory_gib   = 4
disk_gib     = 10 # replaceable root disk
workspace_gib = 10 # persistent project data
agent_home_gib = 2 # persistent settings, memory and sessions
running      = true

# Optional protected configuration, broker and dev executor; both runtimes stay offline.
# Stop both existing runtimes before enabling/upgrading; see docs/secured-runtime.md.
secured_runtime = false
