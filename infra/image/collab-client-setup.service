[Unit]
Description=Connect default agent tools to the shared control broker
Requires=collab-tools-ready.service
After=local-fs.target collab-tools-ready.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/collab-broker-setup clients
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
