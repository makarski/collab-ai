[Unit]
Description=Start the workspace agent user manager for rootless Docker
Requires=collab-workspace-setup.service collab-tools-ready.service
After=collab-workspace-setup.service apparmor.service collab-tools-ready.service
ConditionPathIsMountPoint=/var/lib/collab-ai-docker
ConditionPathExists=/etc/collab-ai/tools/docker.enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/loginctl enable-linger agent
ExecStart=/usr/bin/systemctl start user@1001.service
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
