[Unit]
Description=Release tool-dependent entry points only on an activated tool generation
Requires=collab-tools-setup.service
After=local-fs.target collab-tools-setup.service collab-workspace-setup.service collab-secured-setup.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/collab-tools-ready
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
