#!/usr/bin/python3
"""Gate for tool-dependent entry points: succeed only when this root's tools are released."""

import sys

sys.path.insert(0, "/usr/local/lib/pairtask")
import tool_store  # noqa: E402

if __name__ == "__main__":
    try:
        reason = tool_store.ready()
    except (tool_store.StoreError, OSError) as error:
        reason = str(error)
    if reason:
        print(f"pairtask-tools-ready: {reason}", file=sys.stderr)
        sys.exit(1)
