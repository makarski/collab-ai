#!/usr/bin/env python3
"""Seed Docker defaults as agent; preserve later user settings and opt-outs."""

import json
import os
from pathlib import Path
import subprocess
import sys


def initialize(home):
    marker = home / ".local/state/collab-ai/docker-initialized"
    if marker.exists():
        return
    config = home / ".config/docker/daemon.json"
    config.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        with config.open("x") as stream:
            json.dump({"data-root": "/var/lib/collab-ai-docker"}, stream)
            stream.write("\n")
    except FileExistsError:
        pass
    subprocess.run(["/usr/bin/dockerd-rootless-setuptool.sh", "install"],
                   stdin=subprocess.DEVNULL, check=True)
    marker.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    marker.write_text("Rootless Docker initialized; settings and user service are user-owned.\n")


if __name__ == "__main__":
    if os.getuid() != 1001:
        sys.exit("collab-docker-setup must run as the sandbox agent (uid 1001)")
    os.umask(0o077)
    initialize(Path.home())
