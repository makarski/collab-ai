[Unit]
Description=Initialize rootless Docker in the persistent agent home
Requires=pairtask-docker-session.service
After=pairtask-docker-session.service
ConditionPathIsMountPoint=/var/lib/collab-ai-docker
ConditionPathExists=/etc/pairtask/tools/docker.enabled

[Service]
Type=oneshot
User=agent
Group=agent
Environment=HOME=/home/agent
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus
WorkingDirectory=/home/agent
UMask=0077
ExecStart=/usr/local/lib/pairtask/pairtask-docker-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
