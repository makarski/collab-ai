#!/usr/bin/env python3
"""Initialize volume roots without following agent-controlled child paths."""

import os
from pathlib import Path
import pwd
import sys


def seed_home(home, skeleton, uid, gid):
    for name in (".bashrc", ".profile", ".bash_logout"):
        try:
            descriptor = os.open(home / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            continue  # Preserve existing files, including user-created symlinks.
        with os.fdopen(descriptor, "wb") as stream:
            stream.write((skeleton / name).read_bytes())
            os.fchown(stream.fileno(), uid, gid)


def initialize():
    account = pwd.getpwnam("agent")
    for path, mode in ((Path("/workspace"), 0o750), (Path("/home/agent"), 0o700),
                       (Path("/var/lib/collab-ai-docker"), 0o700)):
        if path.is_symlink() or not path.is_mount():
            raise ValueError(f"Expected an Incus volume at {path}")
        # Never recurse into stored repositories or agent-controlled home paths.
        os.chown(path, account.pw_uid, account.pw_gid)
        path.chmod(mode)
    seed_home(Path("/home/agent"), Path("/etc/skel"), account.pw_uid, account.pw_gid)


if __name__ == "__main__":
    try:
        initialize()
    except (OSError, ValueError) as error:
        sys.exit(f"collab-workspace-setup: {error}")
