[Unit]
Description=Initialize RTK hooks in the persistent agent home
Requires=pairtask-workspace-setup.service pairtask-tools-ready.service
After=pairtask-workspace-setup.service pairtask-tools-ready.service
Before=multi-user.target
ConditionPathIsMountPoint=/home/agent

[Service]
Type=oneshot
User=agent
Group=agent
Environment=HOME=/home/agent
WorkingDirectory=/home/agent
UMask=0077
ExecStart=/usr/local/lib/pairtask/pairtask-rtk-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
