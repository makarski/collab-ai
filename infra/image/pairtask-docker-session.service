[Unit]
Description=Start the workspace agent user manager for rootless Docker
Requires=pairtask-workspace-setup.service pairtask-tools-ready.service
After=pairtask-workspace-setup.service apparmor.service pairtask-tools-ready.service
ConditionPathIsMountPoint=/var/lib/collab-ai-docker
ConditionPathExists=/etc/pairtask/tools/docker.enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/loginctl enable-linger agent
ExecStart=/usr/bin/systemctl start user@1001.service
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
