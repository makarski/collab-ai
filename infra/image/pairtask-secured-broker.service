[Unit]
Description=Shared collaboration broker for control and dev
Requires=pairtask-secured-setup.service pairtask-client-setup.service
After=pairtask-secured-setup.service pairtask-client-setup.service
ConditionPathIsMountPoint=/var/lib/collab-ai-secured
ConditionPathIsMountPoint=/mnt/collab-ipc

[Service]
User=broker
Group=collab-clients
SupplementaryGroups=broker
ExecStartPre=/usr/local/lib/pairtask/pairtask-broker-setup clean
ExecStart=/usr/local/lib/pairtask/pairtask-broker
Environment=PAIRTASK_SOCKET_PATH=/mnt/collab-ipc/broker.sock
Environment=PAIRTASK_DB_PATH=/var/lib/collab-ai-secured/broker/broker.db
# Operator endpoint: private to secured, served only to root (incus exec from the host).
RuntimeDirectory=collab-ai-operator
RuntimeDirectoryMode=0700
Environment=PAIRTASK_OPERATOR_SOCKET_PATH=/run/collab-ai-operator/operator.sock
Environment=PAIRTASK_OPERATOR_UID=0
UMask=0117
TasksMax=32
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/collab-ai-secured/broker /mnt/collab-ipc
Restart=on-failure

[Install]
WantedBy=multi-user.target
